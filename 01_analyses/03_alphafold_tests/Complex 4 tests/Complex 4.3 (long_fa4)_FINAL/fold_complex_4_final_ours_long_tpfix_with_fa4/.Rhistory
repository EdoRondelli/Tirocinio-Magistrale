getwd()
setwd("~/Documents/GitHub/Tirocinio-Magistrale/01_analyses/03_alphafold_tests/Complex 4 tests/Complex 4.3 (long_fa4)_FINAL/fold_complex_4_final_ours_long_tpfix_with_fa4")
# Load libraries
library(jsonlite)
library(ggplot2)
# Read and fix the JSON
raw <- paste(readLines("contact_test.json"), collapse = "")
raw <- paste0("{", raw, "}")
raw <- gsub(",\\s*\\}", "}", raw)
# Parse
data <- fromJSON(raw)
mat <- data$contact_probs
# Convert to binary: 1 if > 0.5, 0 otherwise
binary_mat <- ifelse(mat > 0.5, 1, 0)
# Convert to long format for ggplot
df <- expand.grid(row = 1:nrow(binary_mat), col = 1:ncol(binary_mat))
df$value <- as.vector(binary_mat)
# Divider positions
dividers <- c(516, 743, 1004, 1153, 1262, 1360, 1445, 1524, 1600, 1660, 1725, 1772, 1816)
# Plot
ggplot(df, aes(x = col, y = row, fill = factor(value))) +
geom_raster() +
scale_fill_manual(values = c("0" = "white", "1" = "red")) +
geom_vline(xintercept = dividers, color = "blue", linewidth = 0.3) +
geom_hline(yintercept = dividers, color = "blue", linewidth = 0.3) +
theme_minimal() +
theme(
axis.text = element_blank(),
axis.ticks = element_blank(),
legend.position = "none",
panel.grid = element_blank()
) +
labs(x = NULL, y = NULL)
