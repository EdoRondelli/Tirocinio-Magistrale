# Install the bio3d package if you haven't already: install.packages("bio3d")
library(bio3d)
install.packages("bio3d")
setwd("~/Documents/GitHub/Tirocinio-Magistrale/01_analyses/03_alphafold_tests")
# Read the PDB file
lines <- readLines("~/Documents/GitHub/Tirocinio-Magistrale/01_analyses/03_alphafold_tests/Complex 1 tests/Complex 1.2 (fixed T. peptide)_FINAL/fold_complex_1_peptides_fixed/c1_test.pdb")
# Identify rows with atom data
atom_idx <- which(grepl("^ATOM|^HETATM", lines))
# Extract the original chains and residue numbers
chains <- substr(lines[atom_idx], 22, 22)
resnos <- substr(lines[atom_idx], 23, 26)
# Create a continuous global index based on unique chain-residue combinations
residue_ids <- paste(chains, resnos, sep = "_")
global_resnos <- match(residue_ids, unique(residue_ids))
# Vectorized replacement: Set all chains to 'A' and insert new sequence numbers
substr(lines[atom_idx], 22, 22) <- rep("A", length(atom_idx))
substr(lines[atom_idx], 23, 26) <- sprintf("%4d", global_resnos)
# Save the unified file
writeLines(lines, "collapsed_structure_fast.pdb")
# Read the PDB file lines
lines <- readLines("~/Documents/GitHub/Tirocinio-Magistrale/01_analyses/03_alphafold_tests/Complex 1 tests/Complex 1.2 (fixed T. peptide)_FINAL/fold_complex_1_peptides_fixed/c1_test.pdb")
# Identify rows with atom data
atom_idx <- which(grepl("^ATOM|^HETATM", lines))
# Extract the original chains and residue numbers
chains <- substr(lines[atom_idx], 22, 22)
resnos <- substr(lines[atom_idx], 23, 26)
# Create a sequence of unique chain-residue combinations to track global order
residue_ids <- paste(chains, resnos, sep = "_")
unique_residues <- unique(residue_ids)
global_resnos <- match(residue_ids, unique_residues)
# Update only the residue numbers, keeping chains (col 22) exactly as they are
substr(lines[atom_idx], 23, 26) <- sprintf("%4d", global_resnos)
# Save the updated file
writeLines(lines, "renumbered_structure.pdb")
