# Load the data
df <- read.csv("~/Documents/GitHub/Tirocinio-Magistrale/01_analyses/05_contact/Info_Tables_contact/master_chi2_tables/c4_master_chi2_table.csv")
# Filter out the N/A residues
df_filtered <- subset(df, Not_analysed == 0)
# Construct the contingency table comparing 'Recur_yes' (rows) and 'contact' (columns)
contingency_table <- table(Recur_yes = df_filtered$Recur_yes, Contact = df_filtered$contact)
# Perform the Chi-squared test
chi_sq_result <- chisq.test(contingency_table)
# View the results
print(contingency_table)
print(chi_sq_result)
# Check that the number of removed rows exactly matches the N/A count
nrow(df) - nrow(df_filtered) == sum(df$Not_analysed == 1)
View(df)
# Verify no unanalyzed residues remain (this table should only show '0')
table(df_filtered$Not_analysed)
# Verify no unanalyzed residues remain (this table should only show '0')
table(df_filtered$Not_analysed)
# Confirm Recur_yes and Recur_no are mutually exclusive in the filtered data
sum(df_filtered$Recur_yes + df_filtered$Recur_no != 1) == 0
# Ensure all filtered rows are accounted for in your contingency table
sum(contingency_table) == nrow(df_filtered)
# Print the table with row and column totals for a final visual inspection
addmargins(contingency_table)
# Check that the number of removed rows exactly matches the N/A count
nrow(df) - nrow(df_filtered) == sum(df$Not_analysed == 1)
