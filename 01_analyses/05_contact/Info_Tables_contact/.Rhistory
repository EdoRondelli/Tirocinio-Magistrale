setwd("~/Documents/GitHub/Tirocinio-Magistrale/01_analyses/05_contact/Info_Tables_contact")
#import the table containing all residues as rows and reucr yes/no/NA
all_residues_recur <- read.csv("Complex3_matched_recur/C3_dataframe_posizioni_recur_si_no_NA.csv")
#import the table containing all information about the residues in contact
contact_residue_info <- read.csv("MATRIX_COMPLEX3_WORK/unique_ordered_3.csv")
# Add the contact column
# Convert both to numeric before comparing
all_residues_recur$contact <- as.integer(as.numeric(rownames(all_residues_recur)) %in% as.numeric(contact_residue_info$GloPos1))
# Save the updated table back to CSV
write.csv(all_residues_recur, "master_chi2_tables/c4_master_chi2_table.csv", row.names = FALSE)
# 1. Basic count
table(all_residues_recur$contact)
# 2. Key check - these two numbers should match
sum(all_residues_recur$contact == 1)
length(unique(contact_residue_info$GloPos1))
# 3. Spot check a residue that IS in GloPos1 (e.g. 32 from your image)
all_residues_recur[32, ]   # should show contact = 1
# 4. Spot check a residue that is NOT in GloPos1 (e.g. row 1)
all_residues_recur[1, ]    # should show contact = 0
# 5. Sanity checks
unique(all_residues_recur$contact)      # should only be 0 and 1
sum(is.na(all_residues_recur$contact)) # should be 0
View(all_residues_recur)
View(contact_residue_info)
View(csv_data)
