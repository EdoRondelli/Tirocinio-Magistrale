library(jsonlite)
raw <- paste(readLines("contact_test.json"), collapse = "")
raw <- paste0("{", raw, "}")
raw <- gsub(",\\s*\\}", "}", raw)
data <- fromJSON(raw)
df <- as.data.frame(data$contact_probs)
