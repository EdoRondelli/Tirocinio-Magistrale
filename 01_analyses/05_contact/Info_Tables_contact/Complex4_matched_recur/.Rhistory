setwd("~/Desktop/Complex2_matched_recur")
csv_data <- read.csv("COMPLEX2_ALL_RECURS.csv", header = FALSE)
unique_values <- csv_data[[1]]
df <- data.frame(
Recur_yes    = integer(1167),
Recur_no     = integer(1167),
Not_analysed = integer(1167)
)
View(df)
View(csv_data)
# Set Recur_yes to 1 for rows corresponding to unique values
df$Recur_yes[unique_values] <- 1
# Manual fill of N/A residues, those with X in
# ~/tirocinio_magistrale/01_analyses/05_contact/Recur_correspondents
df$Not_analysed[1:293] <- 1
df$Not_analysed[633:1055] <- 1
# Fill Recur_no with 1 where both Recur_yes and Not_analysed are 0
df$Recur_no[df$Recur_yes == 0 & df$Not_analysed == 0] <- 1
# Check that each row has exactly one 1
all(rowSums(df) == 1)
write.csv(df, "C2_dataframe_posizioni_recur_si_no_NA.csv", row.names = FALSE)
setwd("~/Desktop/Complex3_matched_recur")
csv_data <- read.csv("COMPLEX3_ALL_RECURS.csv", header = FALSE)
unique_values <- csv_data[[1]]
df <- data.frame(
Recur_yes    = integer(2132),
Recur_no     = integer(2132),
Not_analysed = integer(2132)
)
# Set Recur_yes to 1 for rows corresponding to unique values
df$Recur_yes[unique_values] <- 1
# Manual fill of N/A residues, those with X in
# ~/tirocinio_magistrale/01_analyses/05_contact/Recur_correspondents
df$Not_analysed[381:621] <- 1
df$Not_analysed[1509:1584] <- 1
df$Not_analysed[1781:1797] <- 1
df$Not_analysed[1968:2005] <- 1
df$Not_analysed[2132] <- 1
# Fill Recur_no with 1 where both Recur_yes and Not_analysed are 0
df$Recur_no[df$Recur_yes == 0 & df$Not_analysed == 0] <- 1
# Check that each row has exactly one 1
all(rowSums(df) == 1)
# Show which rows don't have exactly one 1
which(rowSums(df) != 1)
View(csv_data)
